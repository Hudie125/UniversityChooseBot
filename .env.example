# Токен вашего Telegram-бота, полученный у @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Опционально: локальный прокси (например, vpGram Xray)
PROXY_URL=socks5://127.0.0.1:17808

# Опционально: бесплатный API-ключ Google Gemini (флагманская ИИ Google 2.0 / 1.5 Flash)
# Получить бесплатно за 10 секунд: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Опционально: бесплатный API-ключ Groq (Llama-3.3 70B)
# Получить бесплатно: https://console.groq.com/keys
GROQ_API_KEY=
